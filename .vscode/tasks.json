{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "presentation": {
        "showReuseMessage": false,
        "clear": true
    },
    "tasks": [
        {
            "label": "Deploy Retail & Forever",
            "dependsOn": [
                "Deploy Retail",
                "Deploy Forever"
            ],
            "problemMatcher": []
        },
        {
            "label": "Deploy All PTR",
            "dependsOn": [
                "Deploy-Retail-PTR",
                "Deploy-Retail-XPTR",
                "Deploy-Retail-Beta"
            ]
        },
        {
            "label": "Deploy Retail",
            "type": "shell",
            "command": "sh .scripts/deploy.sh",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Deploy Forever",
            "type": "shell",
            "command": "sh .scripts/deploy.sh -f",
            "group": "build"
        },
        {
            "label": "Deploy-Retail-PTR",
            "type": "shell",
            "command": "sh .scripts/deploy.sh -p",
            "group": "build"
        },
        {
            "label": "Deploy-Retail-XPTR",
            "type": "shell",
            "command": "sh .scripts/deploy.sh -x",
            "group": "build"
        },
        {
            "label": "Deploy-Retail-Beta",
            "type": "shell",
            "command": "sh .scripts/deploy.sh -b",
            "group": "build"
        },
        {
            "label": "Busted All",
            "type": "shell",
            "command": "busted.bat",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Busted All w/coverage",
            "type": "shell",
            "command": "busted.bat",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "args": [
                "-c"
            ]
        },
        {
            "label": "Busted this file",
            "type": "shell",
            "command": "busted.bat",
            "args": [
                "--lpath=__tests/?.lua;__tests/wow_api/?.lua",
                "-v",
                "${file}"
            ],
            "windows": {
                "options": {
                    "shell": {
                        "executable": "cmd.exe",
                        "args": [
                            "/c"
                        ]
                    }
                }
            },
            "group": "test"
        },
        {
            "label": "Busted List Tests",
            "type": "shell",
            "command": "busted",
            "args": [
                "-l"
            ],
            "group": "test"
        }
    ]
}